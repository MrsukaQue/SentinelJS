{
  "name": "@sentineljs/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "worker": "node src/jobs/worker.js",
    "build": "prisma generate",
    "test": "NODE_ENV=test DATABASE_URL=postgresql://test:test@localhost:5432/test JWT_SECRET=test-only-secret-at-least-32-characters vitest run --exclude '**/*.integration.test.js'",
    "test:integration": "NODE_ENV=test JWT_SECRET=test-only-secret-at-least-32-characters vitest run '**/*.integration.test.js'",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.58.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.9.4",
    "pino-http": "^10.5.0",
    "socket.io": "^4.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "prisma": "6.12.0",
    "supertest": "^7.1.4",
    "vitest": "^5.0.1"
  }
}
