{
  "name": "sentineljs",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server",
    "demo"
  ],
  "scripts": {
    "dev": "concurrently -n api,worker,web,demo -c blue,magenta,cyan,yellow \"npm -w server run dev\" \"npm -w server run worker\" \"npm -w client run dev\" \"npm -w demo start\"",
    "build": "npm -w server run build && npm -w client run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm -w server test",
    "test:integration": "npm -w server run test:integration",
    "db:generate": "npm -w server run db:generate",
    "db:migrate": "npm -w server run db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=22"
  }
}
